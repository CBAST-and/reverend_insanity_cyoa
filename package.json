{
  "name": "ri-cyoa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "convert-data": "tsx scripts/convert-legacy-data.ts",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:migrate:local": "npx wrangler d1 migrations apply ri-cyoa --local",
    "db:seed:local": "npx wrangler d1 execute ri-cyoa --local --file=seed/seed.sql",
    "db:migrate:remote": "npx wrangler d1 migrations apply ri-cyoa --remote",
    "db:seed:remote": "npx wrangler d1 execute ri-cyoa --remote --file=seed/seed.sql",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:full": "vite build && npx wrangler pages dev",
    "deploy": "vite build && npx wrangler pages deploy dist"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/zen-old-mincho": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
